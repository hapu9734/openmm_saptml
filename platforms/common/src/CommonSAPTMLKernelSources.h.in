#ifndef OPENMM_COMMON_SAPTML_KERNEL_SOURCES_H_
#define OPENMM_COMMON_SAPTML_KERNEL_SOURCES_H_

#include <string>

namespace SAPTMLPlugin {

/**
 * This class is a central holding place for the source code of common kernels.
 * The CMake build script inserts declarations into it based on the .cc files in the
 * kernels subfolder.
 */

class CommonSAPTMLKernelSources {
public:
@KERNEL_FILE_DECLARATIONS@
};

} // namespace SAPTMLPlugin

#endif /*OPENMM_COMMON_SAPTML_KERNEL_SOURCES_H_*/
